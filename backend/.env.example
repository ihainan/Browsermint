DATABASE_URL="postgresql://browsermint:browsermint_dev_2026@localhost:24720/browsermint"
JWT_SECRET="change-me-in-production-jwt-secret"
JWT_SESSION_TOKEN_SECRET="change-me-in-production-session-token-secret"
DOCKER_NETWORK_NAME="browsermint-internal"
STEEL_BROWSER_IMAGE="ghcr.io/steel-dev/steel-browser-api:latest"
PORT=24710
LOG_LEVEL=info
NODE_ENV=development
COOKIE_SECURE=false
CAPSOLVER_API_KEY=""
DEFAULT_USER_MAX_SESSIONS=2
# SESSION_TOKEN_EXPIRY=180d

# Session engine: "docker" (default, uses /var/run/docker.sock) or "kubernetes"
# SESSION_DRIVER=kubernetes
# K8S_NAMESPACE=browsermint
# K8S_STORAGE_CLASS=nfs-harbor
# K8S_PVC_SIZE=2Gi
# K8S_SHM_SIZE=1Gi
# K8S_SESSION_CPU_REQUEST=500m
# K8S_SESSION_CPU_LIMIT=2
# K8S_SESSION_MEMORY_REQUEST=1Gi
# K8S_SESSION_MEMORY_LIMIT=2Gi
# K8S_IMAGE_PULL_SECRET=harbor-registry
# K8S_POD_START_TIMEOUT_MS=120000

# Shared secret for the internal service API (POST /api/service/agent-tokens).
# Leave unset to disable the service API entirely.
# SERVICE_ASSERTION_SECRET=
