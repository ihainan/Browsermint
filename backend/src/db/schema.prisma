generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(64)
  email        String    @unique @db.VarChar(256)
  passwordHash String    @db.VarChar(256)
  isAdmin      Boolean   @default(false)
  isActive     Boolean   @default(true)
  maxSessions  Int       @default(2)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String?        @db.VarChar(256)
  status         String         @default("creating") // creating | running | stopping | stopped | error
  containerId    String?        @db.VarChar(128)
  containerName  String?        @db.VarChar(128)
  internalApiUrl String?        @db.VarChar(256)
  savedTabs        Json?          // Restored on resume. Legacy: string[]; now [{label?, url}]
  targetLeases     TargetLease[]
  // Stable external page identity (platform page_id) → current CDP targetId.
  // CDP target ids do not survive a pause (the pod, and with it Chrome, is gone),
  // so embedders that track pages by their own id need this mapping to rebind.
  targetLabels     Json?          // { [label: string]: targetId }
  onlineMs            Int       @default(0)      // Accumulated milliseconds in "running" state
  runningStartedAt    DateTime?                  // When the current "running" period began
  autoRestartAttempts Int       @default(0)      // Incremented on each auto-restart failure; reset to 0 on success
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  expiresAt      DateTime?
  tokenIssuedAt  DateTime?
  deletedAt      DateTime?
  events         SessionEvent[]

  @@index([userId, deletedAt])
  @@index([containerId])
}

/// Single-writer lease over one page target.
///
/// The arbiter has to live here, not in the embedding platform: an agent holds
/// its own BM token and can drive CDP directly, so "the platform sees no running
/// turn" is a UX hint, never a boundary. Everything that writes to a target —
/// user input, the agent's CDP bridge, REST navigate/viewport — funnels through
/// this process, so this is the only place that can actually arbitrate.
model TargetLease {
  id           String   @id @default(uuid()) @db.Uuid
  sessionId    String   @db.Uuid
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetId     String   @db.VarChar(128)
  /// Random fencing token. Renew/release/control all carry it, so a stale window
  /// that wakes up after its lease expired cannot keep writing.
  leaseId      String   @db.VarChar(64)
  /// Who holds it, for the "someone else is driving" notice in other windows.
  holderLabel  String?  @db.VarChar(120)
  holderKey    String   @db.VarChar(128)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([sessionId, targetId])
  @@index([expiresAt])
}

model SessionEvent {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @db.Uuid
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  operationType String   @db.VarChar(64)
  sourceIp      String?  @db.VarChar(45)
  requestPath   String?  @db.VarChar(512)
  source        String?  @db.VarChar(16)  // "frontend" | "agent" | "system"
  statusCode    Int?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@map("session_events")
}
